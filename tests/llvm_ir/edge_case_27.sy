// 测试复杂的条件表达式和函数调用
int is_even(int n) {
    return n % 2 == 0;
}

int is_positive(int n) {
    return n > 0;
}

int main() {
    int a = 6;
    int b = -3;
    
    if (is_even(a) && is_positive(a)) {
        if (is_even(b) || is_positive(b)) {
            return 1;
        } else {
            return 2;
        }
    } else {
        return 3;
    }
}