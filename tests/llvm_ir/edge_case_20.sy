// 测试break和continue在复杂循环中的使用
int main() {
    int i = 0;
    int j = 0;
    int count = 0;
    
    while (i < 5) {
        j = 0;
        while (j < 3) {
            if (i == 2 && j == 1) {
                break;
            }
            if (i == 1 && j == 0) {
                j = j + 1;
                continue;
            }
            count = count + 1;
            j = j + 1;
        }
        if (i == 3) {
            break;
        }
        i = i + 1;
    }
    return count;
}
