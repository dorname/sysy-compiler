// 测试复杂的while循环和break/continue
int main() {
    int i = 0;
    int sum = 0;
    int count = 0;
    
    while (i < 10) {
        if (i % 3 == 0) {
            i = i + 1;
            continue;
        }
        if (i > 7) {
            break;
        }
        sum = sum + i;
        count = count + 1;
        i = i + 1;
    }
    return sum + count;
}