// 测试复杂的全局变量和函数交互
int global_counter = 0;

void increment_global() {
    global_counter = global_counter + 1;
}

int get_global() {
    return global_counter;
}

int main() {
    int local_sum = 0;
    
    increment_global();
    local_sum = local_sum + get_global();
    
    increment_global();
    local_sum = local_sum + get_global();
    
    return local_sum;
}