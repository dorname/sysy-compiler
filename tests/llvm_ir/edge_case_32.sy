// 测试复杂的逻辑表达式和短路
int f1() {
    return 1;
}

int f2() {
    return 0;
}

int main() {
    int a = 0;
    int b = 1;
    
    if (a != 0 && f1() != 0) {
        return 1;
    }
    
    if (b != 0 || f2() != 0) {
        return 2;
    }
    
    if (a == 0 && b != 0) {
        return 3;
    }
    
    return 4;
}