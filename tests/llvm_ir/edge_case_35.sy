// 测试复杂的if-else嵌套和函数调用
int compare(int a, int b) {
    if (a > b) {
        return 1;
    } else if (a < b) {
        return -1;
    } else {
        return 0;
    }
}

int main() {
    int x = 5;
    int y = 3;
    int z = 7;
    
    int result1 = compare(x, y);
    int result2 = compare(y, z);
    
    if (result1 > 0) {
        if (result2 < 0) {
            return 1;
        } else {
            return 2;
        }
    } else {
        return 3;
    }
}