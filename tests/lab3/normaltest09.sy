// Error type 9: Not an array

int func_return_int() {
    return 42;
}

int global_var = 10;

int main() {
    int local_var = 5;
    int another_var = 7;
    
    // Error: using subscript on int variable
    local_var[0];
    
    // Error: using subscript on global variable
    global_var[1];
    
    // Error: using subscript on another variable
    another_var[2];
    
    // Error: using subscript on function name
    func_return_int[0];
    
    // Error: multiple subscripts on non-array
    local_var[0][1];
    
    return 0;
}
