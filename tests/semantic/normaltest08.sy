// Error type 8: Function is not applicable for arguments

int func_no_params() {
    return 1;
}

int func_one_param(int x) {
    return x;
}

int func_two_params(int x, int y) {
    return x + y;
}

void func_array_param(int arr[]) {
    // Just a void function that takes an array parameter
}

int main() {
    int x = 5;
    int arr[3] = {1, 2, 3};
    
    // Error: too many arguments
    func_no_params(1);
    
    // Error: too few arguments
    func_one_param();
    
    // Error: too many arguments
    func_two_params(1, 2, 3);
    
    // Error: wrong parameter count
    func_array_param(arr, x);
    
    return 0;
}
